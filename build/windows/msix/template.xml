<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="twearth"
        Arguments=""
        InstallLocation="C:\Program Files\TWSNMP\TWSNMP Earth">
    </Installer>
    <PackageInformation
        PackageName="TWSNMP Earth"
        PackageDisplayName="TWSNMP Earth"
        PublisherName="CN=TWSNMP"
        PublisherDisplayName="TWSNMP"
        Version="0.1.0.0"
        PackageDescription="TWSNMP Earth Environment Monitor">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.twsnmp.twearth"
                Description="TWSNMP Earth Environment Monitor"
                DisplayName="TWSNMP Earth"
                ExecutableName="twearth"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>TWSNMP Earth</DisplayName>
            <PublisherDisplayName>TWSNMP</PublisherDisplayName>
            <Description>TWSNMP Earth Environment Monitor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="twearth.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
